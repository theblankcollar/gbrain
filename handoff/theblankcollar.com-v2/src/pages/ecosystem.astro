---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";
const lang = "en" as const;

const sites = [
  {
    name: "theblankcollar.com",
    body: "The agency. Services, client work, resources, about.",
    href: "/",
    here: true,
  },
  {
    name: "blankcollar.com",
    body: "Definition + directory. A plain page explaining what \"blank collar\" means, with links to everything in the ecosystem.",
    href: "https://blankcollar.com",
  },
  {
    name: "blankcollar.ai",
    body: "The tools. Products we've built that you can use directly — without hiring us.",
    href: "https://blankcollar.ai",
  },
  {
    name: "blankcollar.vc",
    body: "The venture arm. Where we invest and partner.",
    href: "https://blankcollar.vc",
  },
];
---

<Base
  lang={lang}
  title="Ecosystem — The Blank Collar"
  description="Four domains. One worldview. Each does a specific thing."
>
  <Section>
    <h1 class="font-ultrabold text-display tracking-tightest leading-none">The Blank Collar is more than one site.</h1>
    <p class="mt-8 max-w-2xl text-body-lg text-text/80">
      Four domains. One worldview. Each does a specific thing.
    </p>
  </Section>

  <Section class="!pt-0">
    <div class="grid gap-6 md:grid-cols-2">
      {sites.map((s) => (
        <a class="card flex flex-col" href={s.href} rel={s.href.startsWith("http") ? "noopener" : undefined}>
          <h2 class="font-ultrabold text-h3 tracking-tighter">{s.name}</h2>
          <p class="mt-3 text-body text-text/80">{s.body}</p>
          <span class="mt-6 text-small font-ultrabold uppercase tracking-tighter text-brand-magenta">
            {s.here ? "You're here" : "Visit →"}
          </span>
        </a>
      ))}
    </div>
  </Section>

  <Section tone="gradient">
    <div class="max-w-3xl text-brand-ink">
      <h2 class="font-ultrabold text-h2 tracking-tighter">Why four sites, not one</h2>
      <p class="mt-6 text-body-lg">
        Because each is a different promise. The agency sells outcomes. The tools sell themselves.
        The venture arm invests — different clock, different risk, different counterparty. Putting
        them under one URL would blur all three.
      </p>
      <p class="mt-4 text-body-lg font-ultrabold">
        Same worldview, four surfaces. Each one commits to doing one thing well.
      </p>
    </div>
  </Section>
</Base>
