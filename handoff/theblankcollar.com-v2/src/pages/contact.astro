---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";
const lang = "en" as const;
---

<Base
  lang={lang}
  title="Contact — The Blank Collar"
  description="Start with a problem, not a brief. We reply within 24 hours."
>
  <Section>
    <h1 class="font-ultrabold text-display tracking-tightest leading-none">Start with a problem.</h1>
    <p class="mt-8 max-w-2xl text-body-lg text-text/80">
      Not a brief. Not a meeting request. The actual thing you're trying to change.
    </p>
  </Section>

  <Section class="!pt-0">
    <form
      class="grid max-w-2xl gap-6"
      method="post"
      action="/api/contact"
      novalidate
    >
      <label class="grid gap-2 text-small">
        <span class="font-ultrabold uppercase tracking-tighter">Name</span>
        <input class="rounded-md border border-border/30 bg-surface px-4 py-3 text-body" name="name" required autocomplete="name" />
      </label>
      <label class="grid gap-2 text-small">
        <span class="font-ultrabold uppercase tracking-tighter">Company</span>
        <input class="rounded-md border border-border/30 bg-surface px-4 py-3 text-body" name="company" required autocomplete="organization" />
      </label>
      <label class="grid gap-2 text-small">
        <span class="font-ultrabold uppercase tracking-tighter">Email</span>
        <input type="email" class="rounded-md border border-border/30 bg-surface px-4 py-3 text-body" name="email" required autocomplete="email" />
      </label>
      <label class="grid gap-2 text-small">
        <span class="font-ultrabold uppercase tracking-tighter">What are you trying to change?</span>
        <textarea class="rounded-md border border-border/30 bg-surface px-4 py-3 text-body min-h-[8rem]" name="message" required></textarea>
      </label>
      <label class="grid gap-2 text-small">
        <span class="font-ultrabold uppercase tracking-tighter">Budget range (optional)</span>
        <select class="rounded-md border border-border/30 bg-surface px-4 py-3 text-body" name="budget">
          <option value="unknown">I don't know yet</option>
          <option value="lt50k">&lt;50k</option>
          <option value="50-150k">50–150k</option>
          <option value="150-500k">150–500k</option>
          <option value="500k+">500k+</option>
        </select>
      </label>
      <button class="btn-primary self-start" type="submit" disabled aria-disabled="true">
        Send → (Phase 6)
      </button>
      <p class="text-small text-text/70">
        We reply within 24 hours. If the fit is right, we'll be on a call with you in the same week.
      </p>
    </form>
  </Section>

  <Section tone="ink">
    <h2 class="font-ultrabold text-h2 tracking-tighter">Or reach us directly</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      <a class="rounded-lg border border-brand-paper/20 p-6 hover:border-brand-magenta" href="mailto:hello@theblankcollar.com">
        <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">Email</h3>
        <p class="mt-3 text-small text-brand-paper/80">hello@theblankcollar.com</p>
      </a>
      <a class="rounded-lg border border-brand-paper/20 p-6 hover:border-brand-magenta" href="https://www.linkedin.com/in/kristiankabashi" rel="noopener">
        <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">LinkedIn</h3>
        <p class="mt-3 text-small text-brand-paper/80">linkedin.com/in/kristiankabashi</p>
      </a>
      <div class="rounded-lg border border-brand-paper/20 p-6">
        <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">WhatsApp</h3>
        <p class="mt-3 text-small text-brand-paper/60">By request — start with the form.</p>
      </div>
    </div>
  </Section>

  <Section>
    <h2 class="font-ultrabold text-h2 tracking-tighter">What not to send</h2>
    <ul class="mt-6 max-w-2xl space-y-2 text-body text-text/80">
      <li>— A 40-page RFP</li>
      <li>— An NDA before we've talked</li>
      <li>— "Can you hop on a call?" with no context</li>
      <li>— "We want AI" with nothing else</li>
    </ul>
  </Section>
</Base>
