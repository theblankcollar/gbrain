---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";
import { localizedPath } from "~/i18n/ui";
const lang = "en" as const;
const p = (path: string) => localizedPath(lang, path);

const onramps = [
  {
    title: "Agencies & holding companies",
    problem: "Your delivery is spread across five vendors, each with their own Gantt chart.",
    offer: "One embedded team replaces the sprawl — frameworks, infrastructure, and product shipped in days.",
    examples: "Dentsu, iProspect, Merkle",
    cta: "See agency work",
  },
  {
    title: "Enterprises & scaleups",
    problem: "You're deciding whether to buy, build, or rebuild.",
    offer: "We re-architect operations with AI and ship the product if you need one.",
    examples: "YouGov, Numarics, Cybee.ai",
    cta: "See product work",
  },
  {
    title: "Mid-market leaders",
    problem: "You need an AI plan without a two-quarter consulting slog.",
    offer: "A 24-hour plan. A workshop that ships. Operations rebuilt in 7–14 days.",
    examples: "Mai Group, Alletta, Visorway, Iqtax",
    cta: "See transformation work",
  },
];

const cased = ["Dentsu", "YouGov", "Numarics", "Cybee.ai", "Mai Group", "Alletta", "Visorway", "Iqtax"];
const additional = ["iProspect", "Merkle", "Mandeta"];

const pillars = [
  {
    title: "Services",
    body: "Marketing, ops, finance, HR, automation, product. Delivered by one team, AI-natively, from the same room, with the same context.",
    href: p("/services"),
  },
  {
    title: "Resources",
    body: "Essays, video, podcast, whitepapers, workshops. The Blank Collar publishes at pace.",
    href: p("/resources"),
  },
  {
    title: "Framework",
    body: "The Blank Collar Framework — how we re-architect the operating model instead of bolting AI onto it.",
    href: p("/framework"),
  },
];
---

<Base
  lang={lang}
  title="The Blank Collar — Work is for bots. Life is for humans."
  description="An AI-native transformation agency. One embedded team rebuilds operations with AI instead of bolting it on. Outcomes ship in days, priced on outcomes."
>
  <Section class="!pt-12 md:!pt-20">
    <div class="max-w-4xl">
      <h1 class="font-ultrabold text-display tracking-tightest leading-none">
        Work is for bots.<br />
        <span class="text-brand-magenta">Life is for humans.</span>
      </h1>
      <p class="mt-8 max-w-2xl text-body-lg text-text/80">
        Most companies bolted ChatGPT onto a broken org chart and called it transformation.
        We don't bolt. We rebuild.
      </p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a class="btn-primary" href={p("/contact")}>Start with a problem →</a>
        <a class="btn-secondary" href={p("/services/cases")}>See the work</a>
      </div>
    </div>
  </Section>

  <Section class="!py-16">
    <h2 class="font-ultrabold text-h2 tracking-tighter">Who we work with</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {onramps.map((o) => (
        <article class="card flex flex-col">
          <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">{o.title}</h3>
          <p class="mt-4 text-small text-text/80"><strong class="text-text">Problem.</strong> {o.problem}</p>
          <p class="mt-3 text-small text-text/80"><strong class="text-text">Offer.</strong> {o.offer}</p>
          <p class="mt-3 text-micro uppercase tracking-tighter text-text/60">{o.examples}</p>
          <a class="mt-6 text-small font-ultrabold uppercase tracking-tighter text-brand-magenta" href={p("/services/cases")}>{o.cta} →</a>
        </article>
      ))}
    </div>
  </Section>

  <Section tone="ink" class="!py-16">
    <p class="font-ultrabold text-h3 tracking-tighter">Named clients. Real deliverables. No timesheets.</p>
    <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3 text-body">
      {cased.map((c) => (
        <a class="hover:text-brand-magenta" href={p(`/services/cases/${c.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}`)}>{c}</a>
      ))}
    </div>
    <p class="mt-6 text-small text-brand-paper/60">Also: {additional.join(" · ")}</p>
  </Section>

  <Section>
    <h2 class="font-ultrabold text-h2 tracking-tighter">What we do</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {pillars.map((pl) => (
        <a class="card flex flex-col" href={pl.href}>
          <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">{pl.title}</h3>
          <p class="mt-4 text-small text-text/80">{pl.body}</p>
          <span class="mt-6 text-small font-ultrabold uppercase tracking-tighter text-brand-magenta">Explore →</span>
        </a>
      ))}
    </div>
  </Section>

  <Section tone="gradient">
    <div class="max-w-3xl text-brand-ink">
      <p class="font-ultrabold text-h2 tracking-tighter">Work is for bots. Life is for humans.</p>
      <div class="mt-6 space-y-4 text-body-lg">
        <p>Every company says they're "AI-powered" now. Almost none of them are.</p>
        <p>They bolted ChatGPT onto a broken org chart and called it transformation. Same layers. Same vendors. Same hourly bills. Same tangled machine — running slightly faster toward the same dead end.</p>
        <p>We don't bolt. We rebuild the machine.</p>
        <p>One embedded team. Marketing, ops, finance, HR, automation — delivered AI-natively, from the same room, with the same context. No handoffs. No five-vendor Gantt charts.</p>
        <p>Bots do the work bots should do. Humans do the work only humans can. Outcomes ship in days. Pricing is tied to the outcome — not the timesheet.</p>
        <p class="font-ultrabold">Stop bolting. Rebuild.</p>
      </div>
    </div>
  </Section>

  <Section>
    <h2 class="font-ultrabold text-h2 tracking-tighter">The Blank Collar is more than one site.</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      <a class="card" href="https://blankcollar.ai" rel="noopener">
        <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">blankcollar.ai</h3>
        <p class="mt-3 text-small text-text/80">The tools. What we build, shipped as products you can use.</p>
      </a>
      <a class="card" href="https://blankcollar.vc" rel="noopener">
        <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">blankcollar.vc</h3>
        <p class="mt-3 text-small text-text/80">The venture arm.</p>
      </a>
    </div>
    <a class="mt-6 inline-block text-small font-ultrabold uppercase tracking-tighter text-brand-magenta" href={p("/ecosystem")}>See all →</a>
  </Section>

  <Section tone="gradient">
    <div class="max-w-2xl text-brand-ink">
      <p class="font-ultrabold text-h1 tracking-tightest">Stop bolting. Rebuild.</p>
      <p class="mt-6 text-body-lg">
        Start with a problem, not a brief. We reply within 24 hours and plan within
        24 hours of kickoff.
      </p>
      <a class="btn-primary mt-8" href={p("/contact")}>Work with us →</a>
    </div>
  </Section>
</Base>
