---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";
import { localizedPath } from "~/i18n/ui";
const lang = "en" as const;
const p = (path: string) => localizedPath(lang, path);

const offers = [
  { title: "Transformation Sprint", body: "Eight weeks. We map the operational sprawl, pick the three highest-leverage rebuilds, and ship them. You leave with a new operating model — not a slide deck." },
  { title: "AI-Native Operations Rebuild", body: "Finance, HR, marketing ops rebuilt around agents and automation. One team owns the whole stack." },
  { title: "Product Build", body: "You need a product, not a prototype. We build, ship, and hand over — or stay embedded." },
  { title: "Internal Tool Build", body: "The micro-app your team actually needs. Scoped in a day, shipped in two weeks." },
  { title: "Workshop", body: "Half a day with your leadership team. You leave with a 24-hour plan and the shortlist of what to build first." },
];

const capabilities = [
  { title: "Marketing Operations", body: "Content engines, campaign infra, analytics stacks." },
  { title: "Operations", body: "Process redesign, tool consolidation, agent workflows." },
  { title: "Finance", body: "Billing, FP&A, revenue ops rebuilt around automation." },
  { title: "HR / People", body: "Hiring pipelines, onboarding, internal knowledge systems." },
  { title: "Automation", body: "Integrations, event pipelines, agent-to-agent workflows." },
  { title: "Product & Engineering", body: "Shipping actual software when a deck won't do." },
];

const steps = [
  { n: "01", title: "Workshop (half day)", body: "We meet your leadership. Map what hurts. Pick what ships first." },
  { n: "02", title: "Plan (24 hours)", body: "Full plan within 24h. Scoped deliverables. Outcome-based pricing. Timeline." },
  { n: "03", title: "Ship (7–14 days)", body: "We start shipping the first outcome within two weeks. Actual delivery — not a Gantt chart." },
];
---

<Base
  lang={lang}
  title="Services — The Blank Collar"
  description="One embedded team. Marketing, operations, finance, HR, automation, product — delivered AI-natively, priced on outcomes, shipped in days."
>
  <Section>
    <h1 class="font-ultrabold text-h1 tracking-tightest">What we do</h1>
    <p class="mt-6 max-w-3xl text-body-lg text-text/80">
      One embedded team. Marketing, operations, finance, HR, automation, product — delivered
      AI-natively, priced on outcomes, shipped in days.
    </p>
  </Section>

  <Section class="!pt-0">
    <h2 class="font-ultrabold text-h2 tracking-tighter">Start here</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {offers.map((o) => (
        <article class="card">
          <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">{o.title}</h3>
          <p class="mt-4 text-small text-text/80">{o.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section tone="ink">
    <h2 class="font-ultrabold text-h2 tracking-tighter">Where we plug in</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((c) => (
        <article class="rounded-lg border border-brand-paper/20 p-6">
          <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">{c.title}</h3>
          <p class="mt-3 text-small text-brand-paper/80">{c.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section>
    <h2 class="font-ultrabold text-h2 tracking-tighter">Three steps. Measured in hours and days.</h2>
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {steps.map((s) => (
        <li class="card">
          <span class="font-ultrabold text-h2 tracking-tighter text-brand-magenta">{s.n}</span>
          <h3 class="mt-3 font-ultrabold text-h4 uppercase tracking-tighter">{s.title}</h3>
          <p class="mt-3 text-small text-text/80">{s.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section tone="gradient">
    <div class="max-w-2xl text-brand-ink">
      <p class="font-ultrabold text-h1 tracking-tightest">Start with a problem, not a brief.</p>
      <p class="mt-6 text-body-lg">Tell us what you're trying to change. We reply within 24 hours.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href={p("/contact")}>Work with us →</a>
        <a class="btn-secondary" href={p("/services/cases")}>See all work</a>
      </div>
    </div>
  </Section>
</Base>
