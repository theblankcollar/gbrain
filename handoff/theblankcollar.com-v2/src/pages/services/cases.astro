---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";
import { localizedPath } from "~/i18n/ui";
const lang = "en" as const;
const p = (path: string) => localizedPath(lang, path);

const cases = [
  { slug: "dentsu", client: "Dentsu", what: "Total Collaboration Framework + Data Lake", icp: "Agency" },
  { slug: "yougov", client: "YouGov", what: "Transformation + Buy vs Build", icp: "Enterprise" },
  { slug: "numarics", client: "Numarics", what: "Product build", icp: "Scaleup" },
  { slug: "cybee", client: "Cybee.ai", what: "Product build", icp: "Scaleup" },
  { slug: "mai-group", client: "Mai Group", what: "Transformation workshop", icp: "Mid-market" },
  { slug: "alletta", client: "Alletta", what: "Workshop", icp: "Mid-market" },
  { slug: "visorway", client: "Visorway", what: "Workshop", icp: "Mid-market" },
  { slug: "iqtax", client: "Iqtax", what: "Workshop", icp: "Mid-market" },
];
---

<Base
  lang={lang}
  title="Cases — The Blank Collar"
  description="Eight engagements. Named clients, real deliverables, no timesheets."
>
  <Section>
    <h1 class="font-ultrabold text-h1 tracking-tightest">The work</h1>
    <p class="mt-6 max-w-3xl text-body-lg text-text/80">
      Eight engagements. Named clients, real deliverables, no timesheets. Each case is
      a long-form page — coming in Phase 6.
    </p>
  </Section>

  <Section class="!pt-0">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {cases.map((c) => (
        <article class="card flex flex-col">
          <span class="text-micro uppercase tracking-tighter text-text/60">{c.icp}</span>
          <h2 class="mt-2 font-ultrabold text-h4 uppercase tracking-tighter">{c.client}</h2>
          <p class="mt-3 text-small text-text/80">{c.what}</p>
          <span class="mt-6 text-small font-ultrabold uppercase tracking-tighter text-brand-magenta/60">
            Coming soon →
          </span>
        </article>
      ))}
    </div>
  </Section>

  <Section tone="gradient">
    <div class="max-w-2xl text-brand-ink">
      <p class="font-ultrabold text-h2 tracking-tighter">Want this kind of outcome?</p>
      <a class="btn-primary mt-6" href={p("/contact")}>Work with us →</a>
    </div>
  </Section>
</Base>
