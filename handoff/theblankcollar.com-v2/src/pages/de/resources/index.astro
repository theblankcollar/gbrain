---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";
import { localizedPath } from "~/i18n/ui";
const lang = "de" as const;
const p = (path: string) => localizedPath(lang, path);

const formats = [
  { slug: "essays", title: "Essays", body: "Langform aus der Operator-Perspektive." },
  { slug: "videos", title: "Videos", body: "Interviews, Erklärungen, Demos." },
  { slug: "podcast", title: "Podcast", body: "Lange Gespräche. Eigener RSS-Feed." },
  { slug: "whitepapers", title: "Whitepapers", body: "Tiefe Analysen, PDF und nativ." },
  { slug: "workshops", title: "Workshops", body: "Anmeldung und Selbstlernmodule." },
];
---

<Base
  lang={lang}
  title="Ressourcen — The Blank Collar"
  description="Essays, Video, Podcast, Whitepapers, Workshops. The Blank Collar veröffentlicht im Takt."
>
  <Section>
    <h1 class="font-ultrabold text-h1 tracking-tightest">Ressourcen</h1>
    <p class="mt-6 max-w-3xl text-body-lg text-text/80">
      Essays, Video, Podcast, Whitepapers, Workshops. Aus derselben automatisierten Content-Engine.
    </p>
  </Section>

  <Section class="!pt-0">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {formats.map((f) => (
        <a class="card" href={p(`/resources/${f.slug}`)}>
          <h2 class="font-ultrabold text-h4 uppercase tracking-tighter">{f.title}</h2>
          <p class="mt-3 text-small text-text/80">{f.body}</p>
        </a>
      ))}
    </div>
  </Section>
</Base>
