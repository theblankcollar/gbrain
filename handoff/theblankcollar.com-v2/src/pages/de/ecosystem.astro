---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";
const lang = "de" as const;

const sites = [
  {
    name: "theblankcollar.com",
    body: "Die Agentur. Leistungen, Kundenarbeit, Ressourcen, Über uns.",
    href: "/de/",
    here: true,
  },
  {
    name: "blankcollar.com",
    body: 'Definition + Verzeichnis. Eine einfache Seite, die erklärt, was „Blank Collar" bedeutet, mit Links zu allem im Ökosystem.',
    href: "https://blankcollar.com",
  },
  {
    name: "blankcollar.ai",
    body: "Die Tools. Produkte, die wir gebaut haben und die Sie direkt nutzen können — ohne uns zu engagieren.",
    href: "https://blankcollar.ai",
  },
  {
    name: "blankcollar.vc",
    body: "Der Venture-Arm. Wo wir investieren und Partnerschaften eingehen.",
    href: "https://blankcollar.vc",
  },
];
---

<Base
  lang={lang}
  title="Ökosystem — The Blank Collar"
  description="Vier Domains. Eine Weltanschauung. Jede macht etwas Konkretes."
>
  <Section>
    <h1 class="font-ultrabold text-display tracking-tightest leading-none">The Blank Collar ist mehr als eine Seite.</h1>
    <p class="mt-8 max-w-2xl text-body-lg text-text/80">
      Vier Domains. Eine Weltanschauung. Jede macht etwas Konkretes.
    </p>
  </Section>

  <Section class="!pt-0">
    <div class="grid gap-6 md:grid-cols-2">
      {sites.map((s) => (
        <a class="card flex flex-col" href={s.href} rel={s.href.startsWith("http") ? "noopener" : undefined}>
          <h2 class="font-ultrabold text-h3 tracking-tighter">{s.name}</h2>
          <p class="mt-3 text-body text-text/80">{s.body}</p>
          <span class="mt-6 text-small font-ultrabold uppercase tracking-tighter text-brand-magenta">
            {s.here ? "Sie sind hier" : "Besuchen →"}
          </span>
        </a>
      ))}
    </div>
  </Section>

  <Section tone="gradient">
    <div class="max-w-3xl text-brand-ink">
      <h2 class="font-ultrabold text-h2 tracking-tighter">Warum vier Seiten, nicht eine</h2>
      <p class="mt-6 text-body-lg">
        Weil jede ein anderes Versprechen ist. Die Agentur verkauft Ergebnisse. Die Tools verkaufen
        sich selbst. Der Venture-Arm investiert — andere Zeitachse, anderes Risiko, andere
        Gegenpartei. Alle drei unter einer URL würde alle drei verwischen.
      </p>
      <p class="mt-4 text-body-lg font-ultrabold">
        Dieselbe Weltanschauung, vier Oberflächen. Jede macht eine Sache richtig.
      </p>
    </div>
  </Section>
</Base>
