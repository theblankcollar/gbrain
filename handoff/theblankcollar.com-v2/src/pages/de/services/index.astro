---
import Base from "~/layouts/Base.astro";
import Section from "~/components/Section.astro";
import { localizedPath } from "~/i18n/ui";
const lang = "de" as const;
const p = (path: string) => localizedPath(lang, path);

const offers = [
  { title: "Transformation-Sprint", body: "Acht Wochen. Wir kartieren das operative Chaos, wählen die drei wirkungsstärksten Umbauten — und liefern. Sie gehen mit einem neuen Betriebsmodell raus, nicht mit einem Foliensatz." },
  { title: "KI-natives Operations-Rebuild", body: "Finanzen, HR, Marketing-Ops neu gebaut um Agenten und Automatisierung herum. Ein Team besitzt den ganzen Stack." },
  { title: "Produkt-Build", body: "Sie brauchen ein Produkt, keinen Prototypen. Wir bauen, liefern, übergeben — oder bleiben eingebettet." },
  { title: "Internes Tool", body: "Die Mikro-App, die Ihr Team wirklich braucht. Scope in einem Tag, ausgeliefert in zwei Wochen." },
  { title: "Workshop", body: "Ein halber Tag mit Ihrem Leadership-Team. Sie gehen mit einem 24-Stunden-Plan raus und der Liste, was zuerst gebaut wird." },
];

const capabilities = [
  { title: "Marketing Operations", body: "Content-Engines, Kampagnen-Infrastruktur, Analytics." },
  { title: "Operations", body: "Prozess-Redesign, Tool-Konsolidierung, Agenten-Workflows." },
  { title: "Finanzen", body: "Rechnungsstellung, FP&A, Revenue-Ops neu gebaut um Automatisierung." },
  { title: "HR / People", body: "Hiring-Pipelines, Onboarding, interne Wissenssysteme." },
  { title: "Automatisierung", body: "Integrationen, Event-Pipelines, Agent-zu-Agent-Workflows." },
  { title: "Produkt & Engineering", body: "Echte Software, wenn ein Foliensatz nicht reicht." },
];

const steps = [
  { n: "01", title: "Workshop (halber Tag)", body: "Wir treffen Ihr Leadership. Kartieren, was wehtut. Wählen, was zuerst liefert." },
  { n: "02", title: "Plan (24 Stunden)", body: "Vollständiger Plan in 24h. Scoped Deliverables. Ergebnisbasierte Preise. Zeitplan." },
  { n: "03", title: "Liefern (7–14 Tage)", body: "Erstes Ergebnis in zwei Wochen. Keine Discovery. Kein Gantt. Echte Lieferung." },
];
---

<Base
  lang={lang}
  title="Leistungen — The Blank Collar"
  description="Ein eingebettetes Team. Marketing, Operations, Finanzen, HR, Automatisierung, Produkt — KI-nativ geliefert, an Ergebnissen bemessen, in Tagen ausgeliefert."
>
  <Section>
    <h1 class="font-ultrabold text-h1 tracking-tightest">Was wir machen</h1>
    <p class="mt-6 max-w-3xl text-body-lg text-text/80">
      Ein eingebettetes Team. Marketing, Operations, Finanzen, HR, Automatisierung, Produkt —
      KI-nativ geliefert, an Ergebnissen bemessen, in Tagen ausgeliefert.
    </p>
  </Section>

  <Section class="!pt-0">
    <h2 class="font-ultrabold text-h2 tracking-tighter">Hier anfangen</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {offers.map((o) => (
        <article class="card">
          <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">{o.title}</h3>
          <p class="mt-4 text-small text-text/80">{o.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section tone="ink">
    <h2 class="font-ultrabold text-h2 tracking-tighter">Wo wir andocken</h2>
    <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {capabilities.map((c) => (
        <article class="rounded-lg border border-brand-paper/20 p-6">
          <h3 class="font-ultrabold text-h4 uppercase tracking-tighter">{c.title}</h3>
          <p class="mt-3 text-small text-brand-paper/80">{c.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section>
    <h2 class="font-ultrabold text-h2 tracking-tighter">Drei Schritte. In Stunden und Tagen.</h2>
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {steps.map((s) => (
        <li class="card">
          <span class="font-ultrabold text-h2 tracking-tighter text-brand-magenta">{s.n}</span>
          <h3 class="mt-3 font-ultrabold text-h4 uppercase tracking-tighter">{s.title}</h3>
          <p class="mt-3 text-small text-text/80">{s.body}</p>
        </li>
      ))}
    </ol>
  </Section>

  <Section tone="gradient">
    <div class="max-w-2xl text-brand-ink">
      <p class="font-ultrabold text-h1 tracking-tightest">Mit einem Problem starten.</p>
      <p class="mt-6 text-body-lg">Sagen Sie uns, was Sie verändern wollen. Wir antworten in 24 Stunden.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href={p("/contact")}>Mit uns arbeiten →</a>
        <a class="btn-secondary" href={p("/services/cases")}>Alle Arbeit ansehen</a>
      </div>
    </div>
  </Section>
</Base>
