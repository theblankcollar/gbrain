---
type Props = { class?: string; tone?: "default" | "ink" | "gradient"; id?: string };
const { class: klass = "", tone = "default", id } = Astro.props;
const toneClass =
  tone === "ink"
    ? "bg-brand-ink text-brand-paper"
    : tone === "gradient"
    ? "gradient-sig text-brand-ink"
    : "";
---

<section id={id} class={`py-20 md:py-28 ${toneClass} ${klass}`.trim()}>
  <div class="container-site">
    <slot />
  </div>
</section>
